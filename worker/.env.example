# ============================================================
# Worker configuration (Render free or any Node 20+ host)
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- HTTP server ---
PORT=8080
# Shared secret used by the Edge Function when calling /trigger.
WORKER_SECRET=change-me-shared-with-edge-function

# Public URL of this worker (used to build the /relogin link sent to the frontend).
# Set this to the Render URL once deployed, e.g. https://fb-worker.onrender.com
PUBLIC_BASE_URL=

# Token gating access to /relogin (anyone with this token can submit creds).
# Anyone in the frontend team needs it. Rotate it from time to time.
RELOGIN_TOKEN=change-me-this-protects-the-relogin-page

# --- Session persistence ---
# Local file (lives on Render's ephemeral disk; the real source of truth is the bucket below).
SESSION_LOCAL_PATH=./data/state.json

# Supabase Storage — survives Render restarts.
SESSION_BUCKET=fb-sessions
SESSION_OBJECT_KEY=state.json

# --- Behaviour ---
# Polling interval (ms) for the queue when no HTTP trigger arrives.
POLL_INTERVAL_MS=10000

# Headless in production. Set to "false" only when developing locally.
HEADLESS=true

# Test mode: when true, only `fb_groups.is_test = true` rows are used.
TEST_MODE=true

# Locale (drives FB UI language). Default: fr-FR.
BROWSER_LOCALE=fr-FR

# Optional user-agent override.
USER_AGENT=

# --- Humanization ---
TYPING_MIN_MS=20
TYPING_MAX_MS=80
ACTION_DELAY_MIN_MS=5000
ACTION_DELAY_MAX_MS=15000

# --- Notifications ---
# Optional Slack webhook URL — receives messages when session expires.
SLACK_WEBHOOK_URL=

# --- Temporary image storage ---
TMP_IMAGE_DIR=./data/images
